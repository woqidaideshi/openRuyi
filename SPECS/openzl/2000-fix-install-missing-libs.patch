diff --git a/cli/CMakeLists.txt b/cli/CMakeLists.txt
index c836930..436adeb 100644
--- a/cli/CMakeLists.txt
+++ b/cli/CMakeLists.txt
@@ -40,3 +40,10 @@ add_dependencies(zli
 )
 
 apply_openzl_compile_options_to_target(zli)
+
+# Install zli executable
+if (OPENZL_INSTALL)
+    install(TARGETS zli
+        RUNTIME DESTINATION ${OPENZL_INSTALL_BINDIR}
+        COMPONENT runtime)
+endif()
